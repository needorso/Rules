# --- NAT 穿透 / 实时通信（游戏、语音、视频会议、P2P）---
stun.*                                                   # 真实解析  STUN 地址发现
+.stun.*.*                                               # 真实解析  多级 STUN 服务
+.turn.*                                                 # 真实解析  TURN 中继服务
+._tcp.*                                                 # 真实解析  TCP 服务发现
+._udp.*                                                 # 真实解析  UDP 服务发现
