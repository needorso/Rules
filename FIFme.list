+.dingxiangyun.cn                                        # 真实解析  顶象科技
+.trustdevice.net                                        # 真实解析  TrustDevice 设备风控
+.aegis.qq.com                                           # 真实解析  腾讯安全 鹰眼
+.antpay.com                                             # 真实解析  蚂蚁支付安全
+.rong360.com                                            # 真实解析  百融云创
+.jiguang.cn                                             # 真实解析  极光推送
+.jpush.cn                                               # 真实解析  极光推送
+.jpush.io                                               # 真实解析  极光推送
+.umeng.com                                              # 真实解析  友盟统计
+.umengcloud.com                                         # 真实解析  友盟云
+.rongcloud.cn                                           # 真实解析  融云 IM
+.rongcloud.com                                          # 真实解析  融云
localhost.*.weixin.qq.com                                # 真实解析  微信本地登录
localhost.ptlogin2.qq.com                                # 真实解析  QQ 本地登录
